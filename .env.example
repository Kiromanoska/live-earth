PORT=3000
# Set this in the hosting dashboard, never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
ALLOWED_ORIGINS=https://kiromanoska.github.io,http://localhost:3000
